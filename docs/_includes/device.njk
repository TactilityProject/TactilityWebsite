---
layout: base
---
{%- set t = i18n.strings[lang] -%}
<div class="wrap page">
  <article class="prose">
    <p class="breadcrumb"><a href="{{ "/devices/" | localeUrl(lang) }}">{{ t.device.breadcrumb }}</a> <span aria-hidden="true">/</span> {{ vendor }}</p>
    <h1>{{ title }}</h1>
    <p class="badges">
      {%- set device = { recommended: recommended, psram: psram, sdcard: sdcard, community: community, incubating: incubating } %}
      {% include "badges.njk" %}
    </p>
    {%- set targets = installer | installTargets(deviceSlug or page.fileSlug) %}
    {%- if targets.length > 1 %}
    <p class="install-label">{{ t.device.chooseRevision }}</p>
    {%- endif %}
    <p class="actions device-install">
      {%- for target in targets %}
      {%- set text = (t.device.hardware | replace("{label}", target.label)) if targets.length > 1 else t.device.install %}
      {%- if target.supported === false %}
      <span class="btn btn-disabled" aria-disabled="true">{{ text }}<br><small>{{ t.device.notSupported }}</small></span>
      {%- else %}
      <a class="btn btn-primary" href="{{ site.installer }}{{ ("?lang=" + lang) if lang != i18n.defaultLanguage }}#{{ target.id | urlencode }}">{{ text }}</a>
      {%- endif %}
      {%- endfor %}
    </p>
    {%- if t.device.englishOnly %}
    <p class="page-note translation-note">{{ t.device.englishOnly }}</p>
    <div lang="en">
    {{ content | safe }}
    </div>
    {%- else %}
    {{ content | safe }}
    {%- endif %}
    <p class="page-note">{{ t.device.legendNote | replace("{url}", "/devices/" | localeUrl(lang) + "#legend") | safe }}</p>
  </article>
</div>
