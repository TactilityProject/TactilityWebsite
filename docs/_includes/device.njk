---
layout: base
---
<div class="wrap page">
  <article class="prose">
    <p class="breadcrumb"><a href="/devices/">Supported devices</a> <span aria-hidden="true">/</span> {{ vendor }}</p>
    <h1>{{ title }}</h1>
    <p class="badges">
      {%- set device = { recommended: recommended, psram: psram, sdcard: sdcard, community: community, incubating: incubating } %}
      {% include "badges.njk" %}
    </p>
    {%- set targets = installer | installTargets(page.fileSlug) %}
    {%- if targets.length > 1 %}
    <p class="install-label">Install Tactility: choose your hardware revision</p>
    {%- endif %}
    <p class="actions device-install">
      {%- for target in targets %}
      {%- set text = ("Hardware " + target.label) if targets.length > 1 else "Install Tactility" %}
      {%- if target.supported === false %}
      <span class="btn btn-disabled" aria-disabled="true">{{ text }}<br><small>(not supported)</small></span>
      {%- else %}
      <a class="btn btn-primary" href="{{ site.installer }}#{{ target.id | urlencode }}">{{ text }}</a>
      {%- endif %}
      {%- endfor %}
    </p>
    {{ content | safe }}
    <p class="page-note">What the status markers and badges mean is explained on the <a href="/devices/#legend">supported devices</a> page.</p>
  </article>
</div>
