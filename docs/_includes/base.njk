{%- set t = i18n.strings[lang] %}
{%- set language = lang | languageInfo %}
{#- Page URL without the language prefix, e.g. "/devices/" for "/de/devices/" #}
{#- Pages with `translations: false` (the 404 page) link to the home page of the other languages #}
{%- set basePath = (page.url | localeUrl(i18n.defaultLanguage)) if translations !== false else "/" -%}
<!doctype html>
<html lang="{{ language.hreflang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " | " + site.name) if (title and title != site.name) else (site.name + ": " + t.tagline) %}
  {%- set pageDescription = description or t.description %}
  {%- set canonical = canonicalUrl or page.url %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#16171d">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ site.url }}{{ canonical }}">
  <meta property="og:locale" content="{{ language.ogLocale }}">
  <link rel="canonical" href="{{ site.url }}{{ canonical }}">
  {%- if not canonicalUrl and translations !== false %}
  {%- for item in i18n.languages %}
  <link rel="alternate" hreflang="{{ item.hreflang }}" href="{{ site.url }}{{ basePath | localeUrl(item.code) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ basePath }}">
  {%- endif %}
  <link rel="icon" href="/images/favicon.svg">
  <link rel="mask-icon" href="/images/favicon-safari.svg" color="#000000">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.svg">
  <link rel="preload" href="/assets/fonts/inter.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/site.css' | versioned }}">
  <script>
    // Links from the old site looked like /#/features or /#/devices/lilygo-tdeck
    (function () {
      var m = /^#\/([a-z0-9-]+(?:\/[a-z0-9-]+)?)(?:\.md)?\/?(?:\?id=([a-z0-9_-]+))?$/i.exec(location.hash);
      if (!m) return;
      var path = m[1] === "supported-devices" ? "devices" : m[1];
      location.replace("/" + path + "/" + (m[2] ? "#" + m[2] : ""));
    })();
  </script>
  {%- if lang == i18n.defaultLanguage and translations !== false %}
  <script>
    // First visit to an English page, typed in or from a bookmark (not from a
    // link): go to the same page in the browser's language, if the site has it.
    // A language picked in the language menu is remembered and wins.
    (function () {
      var available = {{ translatedLanguages | dump | safe }};
      try {
        if (localStorage.getItem("language") || document.referrer || /^#\//.test(location.hash)) return;
      } catch (e) {
        return;
      }
      var preferred = navigator.languages || [navigator.language || ""];
      for (var i = 0; i < preferred.length; i++) {
        var code = String(preferred[i]).toLowerCase().split("-")[0];
        if (code === "{{ i18n.defaultLanguage }}") return;
        if (available.indexOf(code) !== -1) {
          location.replace("/" + code + location.pathname + location.search + location.hash);
          return;
        }
      }
    })();
  </script>
  {%- endif %}
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="{{ "/" | localeUrl(lang) }}"><img src="/images/favicon.svg" width="28" height="28" alt="">{{ site.name }}</a>
      <details class="lang-menu">
        <summary aria-label="{{ t.language }}: {{ language.name }}"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>{{ lang | upper }}</summary>
        <ul>
          {%- for item in i18n.languages %}
          <li><a href="{{ basePath | localeUrl(item.code) }}" data-language="{{ item.code }}" hreflang="{{ item.hreflang }}" lang="{{ item.hreflang }}"{% if item.code == lang %} aria-current="true"{% endif %}>{{ item.name }}</a></li>
          {%- endfor %}
        </ul>
      </details>
      <button class="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" hidden>{{ t.menu }}</button>
      <nav id="site-nav" aria-label="Main">
        {%- for item in nav.main %}
        {%- set url = item.url if item.external else (item.url | localeUrl(lang)) %}
        <a href="{{ url }}"{% if not item.external and page.url.startsWith(url) %} aria-current="page"{% endif %}>{{ t.nav[item.key] }}{% if item.external %}<span aria-hidden="true"> ↗</span>{% endif %}</a>
        {%- endfor %}
        <a class="nav-repo" href="{{ site.repo }}">GitHub</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <ul>
        {%- for item in nav.footer %}
        <li><a href="{{ item.url | localeUrl(lang) }}">{{ t.nav[item.key] if item.key else item.label }}</a></li>
        {%- endfor %}
      </ul>
      <ul>
        {%- for item in site.community %}
        <li><a href="{{ item.url }}">{{ item.name }}</a></li>
        {%- endfor %}
        <li><a href="{{ site.youtube }}">YouTube</a></li>
      </ul>
    </div>
  </footer>
  <script>
    (function () {
      var button = document.querySelector(".nav-toggle");
      var nav = document.getElementById("site-nav");
      button.hidden = false;
      document.addEventListener("click", function (event) {
        var menu = document.querySelector(".lang-menu");
        if (menu.open && !menu.contains(event.target)) menu.open = false;
        // Remember a language picked in the menu, so it isn't switched automatically
        var choice = event.target.closest && event.target.closest("[data-language]");
        if (choice) {
          try { localStorage.setItem("language", choice.dataset.language); } catch (e) {}
        }
      });
      nav.classList.add("is-collapsible");
      button.addEventListener("click", function () {
        var open = nav.classList.toggle("is-open");
        button.setAttribute("aria-expanded", open);
      });
    })();
  </script>
</body>
</html>
