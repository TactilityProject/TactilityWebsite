---
layout: base
---
<section class="hero">
  <div class="wrap">
    <div class="hero-text">
      <h1>{{ tagline }}</h1>
      <p class="lead">{{ lead }}</p>
      <p class="actions">
        {%- for action in actions %}
        <a class="btn{% if action.primary %} btn-primary{% endif %}" href="{{ action.url }}">{{ action.label }}</a>
        {%- endfor %}
      </p>
    </div>
    {%- set shot = screenshots | first %}
    {%- set size = shot.src | pngSize %}
    <figure class="bezel hero-shot"><img src="{{ shot.src }}"{% if size %} width="{{ size.width }}" height="{{ size.height }}"{% if size.width <= 320 %} class="pixel"{% endif %}{% endif %} alt="{{ shot.alt }}"></figure>
  </div>
</section>

<section class="wrap shots">
  <div class="shots-track" id="shots-track" role="region" aria-label="Screenshots" tabindex="0">
    {%- for shot in screenshots %}{% if not loop.first %}
    <figure class="bezel">
      {%- set size = shot.src | pngSize %}
      <img src="{{ shot.src }}"{% if size %} width="{{ size.width }}" height="{{ size.height }}"{% if size.height <= 240 %} class="pixel"{% endif %}{% endif %} alt="{{ shot.alt }}" loading="lazy">
      {%- if shot.caption %}<figcaption>{{ shot.caption }}</figcaption>{% endif %}
    </figure>
    {%- endif %}{% endfor %}
  </div>
  <p class="shots-nav" id="shots-nav" hidden>
    <button type="button" data-dir="-1" aria-label="Previous screenshots">←</button>
    <button type="button" data-dir="1" aria-label="Next screenshots">→</button>
  </p>
  <p class="shots-more"><a class="btn" href="{{ site.youtube }}">See it in action on YouTube <span aria-hidden="true">→</span></a></p>
</section>
<script>
  (function () {
    var track = document.getElementById("shots-track");
    var nav = document.getElementById("shots-nav");
    var buttons = [].slice.call(nav.querySelectorAll("button"));
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      nav.hidden = max <= 1;
      buttons[0].disabled = track.scrollLeft <= 1;
      buttons[1].disabled = track.scrollLeft >= max - 1;
    }
    function stepWidth() {
      var item = track.querySelector(".bezel");
      return item.offsetWidth + parseFloat(getComputedStyle(track).columnGap || 0);
    }
    buttons.forEach(function (button) {
      button.addEventListener("click", function () {
        stopAuto();
        var step = stepWidth();
        var count = Math.max(1, Math.floor(track.clientWidth / step));
        track.scrollBy({ left: button.dataset.dir * step * count, behavior: "smooth" });
      });
    });
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();

    // Advance one screenshot at a time until the visitor takes over
    var timer = null;
    var frame = null;
    // Own animation instead of native smooth scrolling, so the slide can be slow and eased.
    // Scroll snapping is switched off while it runs, or it would fight every frame.
    function slideTo(target, duration) {
      cancelSlide();
      var from = track.scrollLeft;
      var began = null;
      track.style.scrollSnapType = "none";
      function tick(now) {
        if (began === null) began = now;
        var p = Math.min(1, (now - began) / duration);
        var eased = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        track.scrollLeft = from + (target - from) * eased;
        if (p < 1) {
          frame = requestAnimationFrame(tick);
        } else {
          frame = null;
          track.style.scrollSnapType = "";
        }
      }
      frame = requestAnimationFrame(tick);
    }
    function cancelSlide() {
      if (frame === null) return;
      cancelAnimationFrame(frame);
      frame = null;
      track.style.scrollSnapType = "";
    }
    function stopAuto() {
      cancelSlide();
      if (timer === null) return;
      clearInterval(timer);
      timer = null;
    }
    function advance() {
      if (document.hidden) return;
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 1) return;
      if (track.scrollLeft >= max - 1) {
        slideTo(0, 1800);
      } else {
        slideTo(Math.min(max, track.scrollLeft + stepWidth()), 1200);
      }
    }
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      timer = setInterval(advance, 5000);
      ["pointerdown", "touchstart", "wheel", "keydown"].forEach(function (name) {
        track.addEventListener(name, stopAuto, { passive: true });
      });
    }
  })();
</script>

<section class="wrap highlights">
  {%- for item in highlights %}
  <a class="card" href="{{ item.url }}">
    <h2>{{ item.title }}</h2>
    <p>{{ item.text }}</p>
  </a>
  {%- endfor %}
</section>

{%- if content | trim %}
<section class="wrap home-body prose">
  {{ content | safe }}
</section>
{%- endif %}

<section class="wrap supporters">
  <h2>Supported by</h2>
  <p>
    {%- for item in supporters %}
    <a href="{{ item.url }}"><img src="{{ item.logo }}" alt="{{ item.name }}" height="44" loading="lazy"></a>
    {%- endfor %}
  </p>
</section>
